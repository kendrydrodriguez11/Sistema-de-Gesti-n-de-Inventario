# ============================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# --- MySQL ---
MYSQL_HOST=mysql-service
MYSQL_PORT=3306
MYSQL_DB=inventory
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=redis-service
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq-service
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# --- JWT ---
# Genera una clave segura con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=3600000

# --- AWS S3 ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
